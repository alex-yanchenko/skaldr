<script>(function(){var b=document.body.dataset.skaldrLive;if(!b)return;var ms=parseInt(b,10)||0;var KEY="skaldr:live:"+location.pathname;var MIN=1500;var last=Date.now();try{var s=JSON.parse(sessionStorage.getItem(KEY)||"null");if(s){window.scrollTo(0,s.y||0);var d=document.querySelectorAll("details");(s.open||[]).forEach(function(i){if(d[i])d[i].open=true})}}catch(e){}var off=false;function save(){var open=[];document.querySelectorAll("details").forEach(function(el,i){if(el.open)open.push(i)});try{sessionStorage.setItem(KEY,JSON.stringify({y:window.scrollY,open:open}))}catch(e){}}function busy(){var sel=window.getSelection();if(sel&&String(sel).length)return true;var el=document.activeElement;return!!(el&&/^(INPUT|TEXTAREA|SELECT)$/.test(el.tagName))}function refresh(){if(off||document.hidden||busy())return;if(Date.now()-last<MIN)return;last=Date.now();save();location.reload()}var tag=document.createElement("button");tag.type="button";tag.className="skaldr-live";tag.textContent="live";tag.title="This page re-reads itself from disk when you return to the tab, so a re-render shows up without a manual refresh. Click to turn it off.";tag.addEventListener("click",function(){off=true;tag.textContent="live off";tag.disabled=true});document.body.appendChild(tag);document.addEventListener("visibilitychange",function(){if(!document.hidden)refresh()});window.addEventListener("focus",refresh);if(ms>0)setInterval(refresh,ms)})();</script>
