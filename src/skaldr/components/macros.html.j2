{# Block renderers. `render_block` dispatches on the discriminated `type`; `badges` is a global. #}

{% set STATUS_GLYPHS = {"done": "✓", "current": "◐", "pending": "○", "failed": "✗", "blocked": "⏸"} %}
{% set DELTA_GLYPHS = {"up": "▲", "down": "▼", "flat": "→"} %}

{% macro chip_item(item) %}
{% if item.key is defined %}{% set b = badges[item.key] %}<span class="chip {{ b.tone }}">{{ b.label }}</span>
{% else %}<span class="chip {{ item.tone }}">{{ item.label }}</span>{% endif %}
{% endmacro %}

{# Chips from declared badge keys, attached to a container (card / timeline item / flow node). A
   <span> wrapper (not <div>) so it's valid inside the inline flow-node txt column too. #}
{% macro chip_keys(keys) %}<span class="chips">{% for key in keys %}<span class="chip {{ badges[key].tone }}">{{ badges[key].label }}</span>{% endfor %}</span>{% endmacro %}

{% macro legend(used_badges) %}
<details class="section"{% if expand_details %} open{% endif %}>
<summary>Legend — badges used on this page</summary>
<div class="section-body">
<div class="legend-grid">
{% for key, b in used_badges %}<div class="legend-row"><span class="chip {{ b.tone }}">{{ b.label }}</span><span class="meaning">{{ b.legend }}</span></div>
{% endfor %}
</div>
</div>
</details>
{% endmacro %}

{# A rich/text table cell: a blank line is a paragraph break (like text.body); a single newline
   collapses. A one-paragraph cell renders inline, so single-line cells are unchanged. #}
{% macro rich_cell(value) -%}
{% set paras = value.split("\n\n") | map("trim") | select | list %}{% if paras | length > 1 %}{% for p in paras %}<p class="cell-p">{{ p | richtext }}</p>{% endfor %}{% else %}{{ value | richtext }}{% endif %}
{%- endmacro %}

{% macro table_row(b, row, cell_cols, title_badges, title_key) %}
{% set rtone = row.get("tone") %}
{# tint_by: an explicit row tone wins, so only resolve a tint when the row sets none. A cell-badge value
   can be a list; the row's tint takes the first key's tone. A blank cell leaves the row untinted. #}
{% set tinttone = none %}
{% if b.tint_by and not rtone %}{% set raw = row[b.tint_by] %}{% set tk = ((raw[0] if raw is iterable and raw is not string else raw) or "") | trim %}{% if tk %}{% set tinttone = badges[tk].tone %}{% endif %}{% endif %}
<tr class="row{% if rtone %} {{ rtone }}{% endif %}{% if tinttone %} tint {{ tinttone }}{% endif %}">
{% for c in cell_cols %}
{% if c.key == title_key %}
<td class="title">{{ rich_cell(row[c.key]) }}
{% for bc in title_badges %}{% set bkey = row[bc.key] | trim %}{% if bkey %}<div><span class="chip {{ badges[bkey].tone }}">{{ badges[bkey].label }}</span></div>{% endif %}{% endfor %}
{% set subs = row.get("subrows") %}{% if subs %}<table class="subtable"><tbody>{% for s in subs %}<tr><td>{{ s.label | richtext }}</td><td class="sv">{{ s.value | fmt }}</td></tr>{% endfor %}</tbody></table>{% endif %}
</td>
{% elif c.kind == "number" %}
<td class="num">{{ row[c.key] | fmt }}{% if c.pct_of_total and b.reconcile %}<span class="pct">{{ pct(row[c.key], b.reconcile.total) }} of total</span>{% endif %}</td>
{% elif c.kind == "indicator" %}
<td class="ind">{% set t = row[c.key] | trim %}{% if t %}<span class="dot {{ t }}" title="{{ t }}"></span>{% endif %}</td>
{% elif c.kind == "badge" %}
<td class="bc">{% set raw = row[c.key] %}{% for key in (raw if raw is iterable and raw is not string else [raw]) %}{% set k = key | trim %}{% if k %}<span class="chip {{ badges[k].tone }}">{{ badges[k].label }}</span>{% endif %}{% endfor %}</td>
{% else %}
<td>{{ rich_cell(row[c.key]) }}</td>
{% endif %}
{% endfor %}
</tr>
{% endmacro %}

{% macro table(b) %}
{# in-cell columns (their own <td>, declared order) vs badges that chip under the title — the model
   owns the split so template and validation can't drift. #}
{% set cell_cols = b.cell_columns %}
{% set title_badges = b.title_badges %}
{% set text_cols = b.columns | selectattr("kind", "equalto", "text") | map(attribute="key") | list %}
{% set rich_cols = b.columns | selectattr("kind", "equalto", "rich") | map(attribute="key") | list %}
{% set title_key = text_cols[0] if text_cols else (rich_cols[0] if rich_cols else cell_cols[0].key) %}
{% set sum_key = b.reconcile.column if b.reconcile else (b.totals.column if b.totals else none) %}
<div class="table-wrap"><table class="rep">
{% set width_total = cell_cols | selectattr("width") | map(attribute="width") | sum %}
<colgroup>{% for c in cell_cols %}<col{% if c.width %} style="width:{{ (c.width / width_total * 100) | round(1) }}%"{% elif c.kind == "number" %} style="width:10%"{% elif c.kind == "indicator" %} style="width:7%"{% endif %}>{% endfor %}</colgroup>
<thead><tr>{% for c in cell_cols %}<th{% if c.kind == "number" %} class="num"{% elif c.kind == "indicator" %} class="ind"{% endif %}>{{ c.label }}</th>{% endfor %}</tr></thead>
<tbody>
{% if b.groups is not none %}
{% for g in b.groups %}
<tr class="group"><td colspan="{{ cell_cols | length }}">{{ g.name }}{% if sum_key %}<span class="st">{{ col_sum(g.rows, sum_key) | fmt }}</span>{% endif %}</td></tr>
{% if g.rows %}{% for row in g.rows %}{{ table_row(b, row, cell_cols, title_badges, title_key) }}{% endfor %}
{% else %}<tr class="empty"><td colspan="{{ cell_cols | length }}">— none —</td></tr>{% endif %}
{% endfor %}
{% else %}
{% for row in b.rows %}{{ table_row(b, row, cell_cols, title_badges, title_key) }}{% endfor %}
{% endif %}
</tbody>
{% if b.totals %}<tfoot><tr>{% for c in cell_cols %}<td{% if c.kind == "number" %} class="num"{% endif %}>{% if c.key == b.totals.column %}{{ col_sum(b.all_rows(), b.totals.column) | fmt }}{% elif loop.first %}Total{% endif %}</td>{% endfor %}</tr></tfoot>{% endif %}
</table></div>
{% set buckets = table_rollup(b) %}
{% if buckets %}<div class="rollup">{% if b.rollup.label %}<span class="rollup-lab">{{ b.rollup.label }}</span>{% endif %}{% for r in buckets %}<span class="rollup-item"><span class="chip {{ badges[r.key].tone }}">{{ badges[r.key].label }}</span><span class="rollup-n">{{ r.count }}</span></span>{% endfor %}</div>{% endif %}
{% if b.reconcile %}<p class="reconcile">{{ reconcile_line(b) }}</p>{% endif %}
{% endmacro %}

{# Flow: a directional pipeline. The connector sits at the FRONT of each node (never the last node
   of a line), so it wraps together with its node — no arrow ever dangles at a line break. #}
{# Detail bullets under a node — shared by flow (both styles) and fan, like chip_keys. #}
{% macro step_points(s) %}{% if s.points %}<ul class="pts">{% for p in s.points %}<li>{{ p | richtext }}</li>{% endfor %}</ul>{% endif %}{% endmacro %}
{% macro list_item_body(item, style) %}{% set text = item if item is string else item.text %}{% set checked = false if item is string else item.checked %}{% if style == "check" %}<label class="chk"><input type="checkbox"{{ " checked" if checked else "" }}><span>{{ text | richtext }}</span></label>{% else %}{{ text | richtext }}{% endif %}{% endmacro %}
{% macro rich_list(items, style) %}<{{ "ol" if style == "number" else "ul" }} class="list{{ " check" if style == "check" else "" }}">{% for item in items %}<li>{{ list_item_body(item, style) }}{% if item is not string and item.items %}{{ rich_list(item.items, style) }}{% endif %}</li>{% endfor %}</{{ "ol" if style == "number" else "ul" }}>{% endmacro %}
{% macro prose_paras(text) %}{% set paras = text.split("\n\n") | map("trim") | select | list %}{% if paras | length > 1 %}{% for p in paras %}<p class="prose-p">{{ p | richtext }}</p>{% endfor %}{% else %}{{ text | richtext }}{% endif %}{% endmacro %}

{% macro flow(b) %}
<div class="flow {{ b.style }}">
<div class="track">
{% if b.style == "steps" %}
{% for s in b.steps %}
<div class="step"><span class="link{% if loop.first %} blank{% endif %}"></span><div class="card{% if s.tone %} {{ s.tone }}{% endif %}">{% if b.numbered %}<span class="n">{{ loop.index }}</span>{% endif %}<div class="lab">{{ s.label }}</div>{% if s.note %}<div class="cap">{{ s.note | richtext }}</div>{% endif %}{{ step_points(s) }}{% if s.badges %}{{ chip_keys(s.badges) }}{% endif %}</div></div>
{% endfor %}
{% else %}
{% for s in b.steps %}
<span class="seg">{% if not loop.first %}<span class="conn"></span>{% endif %}<span class="node{% if s.tone %} {{ s.tone }}{% endif %}">{% if b.numbered %}<span class="n">{{ loop.index }}</span>{% endif %}<span class="txt"><span class="lab">{{ s.label }}</span>{% if s.note %}<span class="sub">{{ s.note | richtext }}</span>{% endif %}{{ step_points(s) }}{% if s.badges %}{{ chip_keys(s.badges) }}{% endif %}</span></span></span>
{% endfor %}
{% endif %}
</div>
{% if b.loop %}<div class="loop"><span class="cyc">↺</span> back to {{ b.steps[0].label }}</div>{% endif %}
</div>
{% endmacro %}

{# Fan: one-to-many convergence/divergence. The 'many' spokes sit in a dashed well; a single arrow
   joins them to the one hub. DOM order follows direction so the arrow always points along the flow. #}
{% macro fan_node(s) %}<div class="fnode{% if s.tone %} {{ s.tone }}{% endif %}"><span class="lab">{{ s.label }}</span>{% if s.note %}<span class="sub">{{ s.note | richtext }}</span>{% endif %}{{ step_points(s) }}{% if s.badges %}{{ chip_keys(s.badges) }}{% endif %}</div>{% endmacro %}

{% macro fan_spokes(b) %}<div class="spokes">{% for s in b.spokes %}{{ fan_node(s) }}{% endfor %}</div>{% endmacro %}

{% macro fan(b) %}
<div class="fan {{ b.direction }}">
{% if b.direction == "out" %}<div class="hub">{{ fan_node(b.hub) }}</div><div class="merge"><span class="arw">→</span></div>{{ fan_spokes(b) }}
{% else %}{{ fan_spokes(b) }}<div class="merge"><span class="arw">→</span></div><div class="hub">{{ fan_node(b.hub) }}</div>{% endif %}
</div>
{% endmacro %}

{% macro chart(b) %}
<figure class="chart {{ b.variant }}">
{% if b.title %}<figcaption class="cap">{{ b.title }}</figcaption>{% endif %}
{{ chart_svg(b) }}
<div class="chart-legend">{% for item in chart_legend(b) %}<span><i style="background:{{ item.colour }}"></i>{{ item.label }}{% if item.note %} {{ item.note }}{% endif %}</span>{% endfor %}</div>
</figure>
{% endmacro %}

{# A ✓/✗ cell: the glyph marks present/absent (from the value); the colour marks good/bad. `neg` flips
   good/bad for a present-is-bad column, so `cell != neg` is good (green) and the other is bad (red). #}
{% macro cmp_cell(cell, neg=false) %}{% if cell is boolean %}<span class="chk {{ 'good' if cell != neg else 'bad' }}">{{ '✓' if cell else '✗' }}</span>{% elif cell is string %}{{ cell | richtext }}{% else %}<span class="ct{% if cell.tone %} {{ cell.tone }}{% endif %}">{{ cell.value | richtext }}</span>{% endif %}{% endmacro %}

{% macro comparison(b) %}
<table class="cmp"><thead><tr><th></th>{% for opt in b.options %}<th{% if loop.index0 == b.highlight %} class="hl"{% endif %}>{{ opt }}</th>{% endfor %}</tr></thead>
<tbody>{% for row in b.rows %}<tr><td class="feat">{{ row.feature }}</td>{% for cell in row.values %}<td{% if loop.index0 == b.highlight %} class="hl"{% endif %}>{{ cmp_cell(cell, (b.polarity[loop.index0] == 'negative') if b.polarity else false) }}</td>{% endfor %}</tr>{% endfor %}</tbody></table>
{% endmacro %}

{% macro references(b) %}
<ol class="refs">{% for item in b.items %}<li id="ref-{{ item.key }}">{% if item.key in cited_references %}<a class="rnum" href="#fnref-{{ item.key }}">{{ reference_numbers[item.key] }}</a>{% else %}<span class="rnum">{{ reference_numbers[item.key] }}</span>{% endif %}<span class="rtext">{{ item.text | richtext }}{% if item.url %} <a class="rlink" href="{{ item.url }}">↗</a>{% endif %}</span></li>{% endfor %}</ol>
{% endmacro %}

{# Range: a horizontal bar of segments sized in proportion to their spans. `flex:<span>` (grow, basis 0)
   distributes the bar's width by the span ratios exactly — no percentage math, no rounding gap. Optional
   axis renders end-cap labels. (Soft-tint rationale lives with the .range CSS.) #}
{% macro range_bar(b) %}
<div class="range">
<div class="rbar">{% for s in b.segments %}<div class="rseg {{ s.tone or 'neutral' }}" style="flex:{{ s.span }}"><span class="rlab">{{ s.label }}</span>{% if s.sub %}<span class="rsub">{{ s.sub | richtext }}</span>{% endif %}</div>{% endfor %}</div>
{% if b.axis %}<div class="raxis"><span class="rmin">{{ b.axis.min or "" }}</span><span class="rmax">{{ b.axis.max or "" }}</span></div>{% endif %}
</div>
{% endmacro %}

{# Swimlane: a lane×column matrix (rows = lanes, columns = the declared sprint/phase axis) with an
   optional group (milestone) overlay. `swimlane_layout` computes every element's grid placement, so
   this macro only places pre-computed lines: the table fill, the sprint header (tinted per group with
   one label per column), lane gutter, cells (each step shows its number — a link when it has a url —
   its label, and optional value; its progress state colours the badge + left edge — done/current/todo/blocked/deferred),
   the grey grid (solid column boundaries + dashed group splits), the group caps beyond the table, an
   optional footer totals row, and the rounded frame. Columns fill the width, scrolling when narrow. #}
{% macro swimlane(b) %}
{% set layout = swimlane_layout(b) %}
<div class="swim-wrap"><div class="swim" style="grid-template-columns:{{ layout.col_template }};grid-template-rows:{{ layout.row_template }}">
<div class="swim-tbl" style="grid-column:{{ layout.tbl.line_start }}/{{ layout.tbl.line_end }};grid-row:{{ layout.tbl.row_start }}/{{ layout.tbl.row_end }}"></div>
{% for h in layout.header_tints %}<div class="swim-hcell{% if h.tone %} {{ h.tone }}{% endif %}" style="grid-column:{{ h.line_start }}/{{ h.line_end }};grid-row:{{ h.row_start }}/{{ h.row_end }}"></div>{% endfor %}
{% for h in layout.headers %}<div class="swim-hlabel" style="grid-column:{{ h.line_start }}/{{ h.line_end }};grid-row:{{ h.row_start }}/{{ h.row_end }}">{{ h.label }}{% if h.sub %}<span class="swim-hsub">{{ h.sub }}</span>{% endif %}</div>{% endfor %}
{% for g in layout.gutter %}<div class="swim-gut" style="grid-column:1;grid-row:{{ g.row_start }}/{{ g.row_end }}">{{ g.lane }}{% if g.total is not none %}<span class="swim-tot">{{ g.total | fmt }}</span>{% endif %}</div>{% endfor %}
{% if layout.foot is not none %}<div class="swim-gut swim-foot-lbl{% if not layout.foot.banded %} bare{% endif %}" style="grid-column:1;grid-row:{{ layout.foot.row_start }}/{{ layout.foot.row_end }}">{{ layout.foot.label }}</div>{% for f in layout.foot.cells %}<div class="swim-foot{% if not layout.foot.banded %} bare{% endif %}" style="grid-column:{{ f.line_start }}/{{ f.line_end }};grid-row:{{ f.row_start }}/{{ f.row_end }}"><span class="swim-tot">{{ f.total | fmt }}</span></div>{% endfor %}{% endif %}
{% for c in layout.cells %}<div class="swim-cell{% if c.tone %} {{ c.tone }}{% endif %}" style="grid-column:{{ c.line_start }}/{{ c.line_end }};grid-row:{{ c.row_start }}/{{ c.row_end }}">{% for s in c.steps %}<div class="swim-tkt {{ s.state }}">{% if s.url %}<a class="swim-n" href="{{ s.url }}">{{ s.n }}</a>{% else %}<span class="swim-n">{{ s.n }}</span>{% endif %}<span class="swim-body"><span class="swim-l">{{ s.label }}</span>{% if s.deps %}<span class="swim-dep">{{ s.deps | join(", ") }}</span>{% endif %}</span>{% if s.value is not none %}<span class="swim-tkt-v">{{ s.value | fmt }}</span>{% endif %}</div>{% endfor %}</div>{% endfor %}
{% for h in layout.hdiv %}<div class="swim-hdiv" style="grid-column:{{ h.col_start }}/{{ layout.tbl.line_end }};grid-row:{{ h.row }}"></div>{% endfor %}
{% for v in layout.vdash %}<div class="swim-vdash" style="grid-column:{{ v.col_start }}/{{ v.col_end }};grid-row:{{ v.row_start }}/{{ v.row_end }}"></div>{% endfor %}
{% for v in layout.vsolid %}<div class="swim-vsolid{% if v.poke %} poke{% endif %}" style="grid-column:{{ v.col_start }}/{{ v.col_end }};grid-row:{{ v.row_start }}/{{ v.row_end }}"></div>{% endfor %}
{% for c in layout.caps %}<div class="swim-cap {{ c.color }}{% if c.edges %} {{ c.edges }}{% endif %}" style="grid-column:{{ c.line_start }}/{{ c.line_end }};grid-row:{{ c.row_start }}/{{ c.row_end }}"><span class="swim-dot"></span>{{ c.label }}{% if c.total is not none %}<span class="swim-tot">{{ c.total | fmt }}</span>{% endif %}</div>{% endfor %}
{% for c in layout.caps_bottom %}<div class="swim-capb {{ c.color }}{% if c.edges %} {{ c.edges }}{% endif %}" style="grid-column:{{ c.line_start }}/{{ c.line_end }};grid-row:{{ c.row_start }}/{{ c.row_end }}"></div>{% endfor %}
<div class="swim-frame{% if layout.frame_square_right %} sq-right{% endif %}" style="grid-column:{{ layout.tbl.line_start }}/{{ layout.tbl.line_end }};grid-row:{{ layout.tbl.row_start }}/{{ layout.tbl.row_end }}"></div>
</div>{% if layout.state_legend %}<div class="swim-legend">{% for s in layout.state_legend %}<span class="swim-leg"><span class="swim-leg-sw {{ s }}"></span>{{ s }}</span>{% endfor %}</div>{% endif %}</div>
{% endmacro %}

{# Matrix: rows × columns, one state per cell — a coverage / RACI / capability grid. The cell IS the
   state: a badge (its tone fills the cell, its label is the text) or a one-off tone fill, each with
   optional short text; a blank (unfilled) cell is empty. `matrix_grid` places every cell row-major, so
   this macro only loops. A cell's fill class is a badge/palette colour name, sharing the chip tokens. #}
{% macro matrix(b) %}
{% set grid = matrix_grid(b) %}
<div class="mx-wrap"><table class="mx">
<thead><tr><th></th>{% for col in b.columns %}<th>{{ col }}</th>{% endfor %}</tr></thead>
<tbody>
{% for row in b.rows %}{% set rowcells = grid[loop.index0] %}<tr><th>{{ row }}</th>{% for cell in rowcells %}{% if cell is none %}<td class="c"><span></span></td>{% else %}{% if cell.badge %}{% set tone = badges[cell.badge].tone %}{% set text = cell.label or badges[cell.badge].label %}{% elif cell.tone %}{% set tone = cell.tone %}{% set text = cell.label or "" %}{% else %}{% set tone = none %}{% set text = cell.label %}{% endif %}<td class="c{% if tone %} {{ tone }}{% endif %}"><span>{{ text }}</span></td>{% endif %}{% endfor %}</tr>
{% endfor %}
</tbody>
</table></div>
{% endmacro %}

{# A derived card (chip on top): its value + percentage are COUNTED — from the cells of one matrix
   (`of_matrix`) or from the rows of several tables (`of_tables`, summed) — never authored. The badge
   supplies the chip, the label (unless overridden), and the card's border tone — both the chip and the
   border read the same palette colour name. #}
{% macro derived_card(c) %}
{% set b = badges[c.badge] %}
{% if c.of_matrix %}{% set mt = matrix_tallies[c.of_matrix] %}{% set count = mt.counts.get(c.badge, 0) %}{% set total = mt.total %}{% else %}{% set agg = namespace(count=0, total=0) %}{% for tid in c.of_tables %}{% set tt = table_tallies[tid] %}{% set agg.count = agg.count + tt.counts.get(c.badge, 0) %}{% set agg.total = agg.total + tt.total %}{% endfor %}{% set count = agg.count %}{% set total = agg.total %}{% endif %}
<div class="card {{ c.tone or b.tone }}"><span class="chip {{ b.tone }} cbadge">{{ c.label or b.label }}</span><div class="n">{{ count | fmt }}<span class="pct">{{ pct(count, total) }}</span></div>{% if c.note %}<div class="note">{{ c.note }}</div>{% endif %}</div>
{% endmacro %}

{% macro render_block(block) %}
{%- if block.span %}<div class="blk span-{{ block.span }}">{% endif -%}
{% if block.type == "heading" %}
<h{{ block.level }} id="{{ anchor_id(block) }}">{{ block.text }}{% if block.sub %}<span class="hsub">{{ block.sub | richtext }}</span>{% endif %}</h{{ block.level }}>
{% elif block.type == "text" %}
{% for para in block.body.split("\n\n") %}<p class="text{% if block.muted %} muted{% endif %}">{{ para | richtext }}</p>{% endfor %}
{% elif block.type == "list" %}
{{ rich_list(block.items, block.style) }}
{% elif block.type == "fact_strip" %}
<div class="facts">{% for f in block.facts %}<span class="fact"><span class="k">{{ f.label }}</span><span>{{ f.value }}</span></span>{% endfor %}</div>
{% elif block.type == "key_value" %}
<dl class="kv">{% for p in block.pairs %}<dt>{{ p.label }}</dt><dd>{{ p.value | richtext }}</dd>{% endfor %}</dl>
{% elif block.type == "def_list" %}
<dl class="deflist">{% for it in block.items %}<dt>{{ it.term }}</dt><dd>{{ prose_paras(it.body) }}</dd>{% endfor %}</dl>
{% elif block.type == "cards" %}
<div class="cards">{% for c in block.items %}{% if c.of_matrix or c.of_tables %}{{ derived_card(c) }}{% else %}<div class="card{% if c.tone %} {{ c.tone }}{% endif %}"><div class="l">{{ c.label }}</div><div class="n{% if c.value is string %} str{% elif c.value < 0 %} neg{% endif %}">{{ c.value | fmt }}{% if c.of %}<span class="pct">{{ pct(c.value, c.of) }}</span>{% endif %}{% if c.delta %}<span class="delta {{ c.delta.tone or 'neutral' }}">{% if c.delta.direction %}{{ DELTA_GLYPHS[c.delta.direction] }} {% endif %}{{ c.delta.label }}</span>{% endif %}</div>{% if c.note %}<div class="note">{{ c.note }}</div>{% endif %}{% if c.badges %}{{ chip_keys(c.badges) }}{% endif %}</div>{% endif %}{% endfor %}</div>
{% elif block.type == "badge_row" %}
{% if block.groups %}<dl class="badge-groups">{% for g in block.groups %}<dt>{{ g.label }}</dt><dd>{% for item in g.items %}{{ chip_item(item) }}{% endfor %}</dd>{% endfor %}</dl>{% else %}<div class="badge-row">{% if block.label %}<span class="label">{{ block.label }}</span>{% endif %}{% for item in block.items %}{{ chip_item(item) }}{% endfor %}</div>{% endif %}
{% elif block.type == "callout" %}
<div class="callout {{ block.tone }}">{% if block.title %}<div class="title">{{ block.title }}</div>{% endif %}<div>{{ prose_paras(block.body) }}</div></div>
{% elif block.type == "status_list" %}
<ul class="status-list">{% for item in block.items %}<li class="{{ item.state }}"><span class="glyph">{{ STATUS_GLYPHS[item.state] }}</span><span>{{ item.text | richtext }}</span></li>{% endfor %}</ul>
{% elif block.type == "meter" %}
<div class="meter">{% for m in block.items %}<span class="m-label">{{ m.label }}</span><div class="track"><div class="fill {{ m.tone or 'neutral' }}" style="width:{{ (m.value / m.max * 100) | round(1) }}%"></div></div><span class="m-val">{{ pct(m.value, m.max) }}</span>{% endfor %}</div>
{% elif block.type == "range" %}
{{ range_bar(block) }}
{% elif block.type == "code" %}
<div class="code">{% if block.label %}<div class="code-label">{{ block.label }}</div>{% endif %}{% if block.mode == "diff" %}<pre class="diff">{% for line in block.content.split("\n") %}<span class="ln {{ 'add' if line.startswith('+') else 'del' if line.startswith('-') else 'ctx' }}">{{ line[1:] if (line.startswith('+') or line.startswith('-')) else line }}</span>{% endfor %}</pre>{% else %}<pre>{{ block.content }}</pre>{% endif %}</div>
{% elif block.type == "quote" %}
<blockquote class="quote"><div>{{ prose_paras(block.body) }}</div>{% if block.cite %}<span class="cite">{{ block.cite }}</span>{% endif %}</blockquote>
{% elif block.type == "note" %}
<div class="note-block">{% if block.title %}<div class="note-block-title">{{ block.title }}</div>{% endif %}<div>{{ prose_paras(block.body) }}</div></div>
{% elif block.type == "image" %}
<figure class="fig"{% if block.max_width %} style="max-width:{{ block.max_width }}px"{% endif %}><div class="frame"><img src="{{ block.src }}" alt="{{ block.alt }}"></div>{% if block.caption %}<figcaption>{{ block.caption }}</figcaption>{% endif %}</figure>
{% elif block.type == "timeline" %}
<ul class="tl">{% for it in block.items %}<li{% if it.state %} class="{{ it.state }}"{% endif %}>{% if it.time %}<div class="time">{{ it.time }}</div>{% endif %}<div class="ti">{{ it.title }}</div>{% if it.body %}<div class="tb">{{ it.body | richtext }}</div>{% endif %}{% if it.badges %}{{ chip_keys(it.badges) }}{% endif %}</li>{% endfor %}</ul>
{% elif block.type == "flow" %}
{{ flow(block) }}
{% elif block.type == "fan" %}
{{ fan(block) }}
{% elif block.type == "chart" %}
{{ chart(block) }}
{% elif block.type == "comparison" %}
{{ comparison(block) }}
{% elif block.type == "matrix" %}
{{ matrix(block) }}
{% elif block.type == "swimlane" %}
{{ swimlane(block) }}
{% elif block.type == "references" %}
{{ references(block) }}
{% elif block.type == "table" %}
{{ table(block) }}
{% elif block.type == "section" %}
<details class="section" id="{{ anchor_id(block) }}"{% if not block.collapsed or expand_details %} open{% endif %}><summary>{{ block.title }}{% if block.updated %}<span class="upd">updated {{ block.updated }}</span>{% endif %}</summary><div class="section-body">{% for inner in block.blocks %}{{ render_block(inner) }}{% endfor %}</div></details>
{% elif block.type == "panel" %}
<div class="panel-card"><div class="panel-card-hd">{{ block.title }}</div><div class="panel-card-body">{% for inner in block.blocks %}{{ render_block(inner) }}{% endfor %}</div></div>
{% elif block.type == "grid" %}
<div class="grid">{% for cell in block.cells %}<div class="cell span-{{ cell.span }}{% if cell.tone %} panel {{ cell.tone }}{% endif %}">{% for inner in cell.blocks %}{{ render_block(inner) }}{% endfor %}</div>{% endfor %}</div>
{% elif block.type == "walkthrough" %}
<div class="walk" style="grid-template-columns:minmax(120px,{{ block.step_span }}fr) {{ 6 - block.step_span }}fr">{% for step in block.steps %}<div class="wstep{% if step.tone %} {{ step.tone }}{% endif %}"><span class="wnum">{{ loop.index }}</span><span class="wlabel">{{ step.label }}{% if step.sub %}<span class="wsub">{{ step.sub | richtext }}</span>{% endif %}</span></div><div class="wdetail">{% for inner in step.detail %}{{ render_block(inner) }}{% endfor %}</div>{% endfor %}</div>
{% endif %}
{%- if block.span %}</div>{% endif -%}
{% endmacro %}
