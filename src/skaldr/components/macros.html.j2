{# Block renderers. `render_block` dispatches on the discriminated `type`; `badges` is a global. #}

{% set STATUS_GLYPHS = {"done": "✓", "current": "◐", "pending": "○", "failed": "✗", "blocked": "⏸"} %}
{% set DELTA_GLYPHS = {"up": "▲", "down": "▼", "flat": "→"} %}

{% macro chip_item(item) %}
{% if item.key is defined %}{% set b = badges[item.key] %}<span class="chip {{ b.tone }}">{{ b.label }}</span>
{% else %}<span class="chip {{ item.tone }}">{{ item.label }}</span>{% endif %}
{% endmacro %}

{# Chips from declared badge keys, attached to a container (card / timeline item / flow node). A
   <span> wrapper (not <div>) so it's valid inside the inline flow-node txt column too. #}
{% macro chip_keys(keys) %}<span class="chips">{% for key in keys %}<span class="chip {{ badges[key].tone }}">{{ badges[key].label }}</span>{% endfor %}</span>{% endmacro %}

{% macro legend(used_badges) %}
<details class="section"{% if expand_details %} open{% endif %}>
<summary>Legend — badges used on this page</summary>
<div class="section-body">
<div class="legend-grid">
{% for key, b in used_badges %}<div class="legend-row"><span class="chip {{ b.tone }}">{{ b.label }}</span><span class="meaning">{{ b.legend }}</span></div>
{% endfor %}
</div>
</div>
</details>
{% endmacro %}

{% macro table_row(b, row, non_badge, badge_cols, title_key) %}
{% set rtone = row.get("tone") %}
<tr class="row{% if rtone %} {{ rtone }}{% endif %}">
{% for c in non_badge %}
{% if c.key == title_key %}
<td class="title">{{ row[c.key] | richtext }}
{% for bc in badge_cols %}{% set bkey = row[bc.key] | trim %}{% if bkey %}<div><span class="chip {{ badges[bkey].tone }}">{{ badges[bkey].label }}</span></div>{% endif %}{% endfor %}
{% set subs = row.get("subrows") %}{% if subs %}<table class="subtable"><tbody>{% for s in subs %}<tr><td>{{ s.label | richtext }}</td><td class="sv">{{ s.value | fmt }}</td></tr>{% endfor %}</tbody></table>{% endif %}
</td>
{% elif c.kind == "number" %}
<td class="num">{{ row[c.key] | fmt }}{% if c.pct_of_total and b.reconcile %}<span class="pct">{{ pct(row[c.key], b.reconcile.total) }} of total</span>{% endif %}</td>
{% elif c.kind == "indicator" %}
<td class="ind">{% set t = row[c.key] | trim %}{% if t %}<span class="dot {{ t }}" title="{{ t }}"></span>{% endif %}</td>
{% else %}
<td>{{ row[c.key] | richtext }}</td>
{% endif %}
{% endfor %}
</tr>
{% endmacro %}

{% macro table(b) %}
{% set non_badge = b.columns | rejectattr("kind", "equalto", "badge") | list %}
{% set badge_cols = b.columns | selectattr("kind", "equalto", "badge") | list %}
{% set text_cols = b.columns | selectattr("kind", "equalto", "text") | map(attribute="key") | list %}
{% set rich_cols = b.columns | selectattr("kind", "equalto", "rich") | map(attribute="key") | list %}
{% set title_key = text_cols[0] if text_cols else (rich_cols[0] if rich_cols else non_badge[0].key) %}
{% set sum_key = b.reconcile.column if b.reconcile else (b.totals.column if b.totals else none) %}
<div class="table-wrap"><table class="rep">
{% set width_total = non_badge | selectattr("width") | map(attribute="width") | sum %}
<colgroup>{% for c in non_badge %}<col{% if c.width %} style="width:{{ (c.width / width_total * 100) | round(1) }}%"{% elif c.kind == "number" %} style="width:10%"{% elif c.kind == "indicator" %} style="width:7%"{% endif %}>{% endfor %}</colgroup>
<thead><tr>{% for c in non_badge %}<th{% if c.kind == "number" %} class="num"{% elif c.kind == "indicator" %} class="ind"{% endif %}>{{ c.label }}</th>{% endfor %}</tr></thead>
<tbody>
{% if b.groups is not none %}
{% for g in b.groups %}
<tr class="group"><td colspan="{{ non_badge | length }}">{{ g.name }}{% if sum_key %}<span class="st">{{ col_sum(g.rows, sum_key) | fmt }}</span>{% endif %}</td></tr>
{% if g.rows %}{% for row in g.rows %}{{ table_row(b, row, non_badge, badge_cols, title_key) }}{% endfor %}
{% else %}<tr class="empty"><td colspan="{{ non_badge | length }}">— none —</td></tr>{% endif %}
{% endfor %}
{% else %}
{% for row in b.rows %}{{ table_row(b, row, non_badge, badge_cols, title_key) }}{% endfor %}
{% endif %}
</tbody>
{% if b.totals %}<tfoot><tr>{% for c in non_badge %}<td{% if c.kind == "number" %} class="num"{% endif %}>{% if c.key == b.totals.column %}{{ col_sum(b.all_rows(), b.totals.column) | fmt }}{% elif loop.first %}Total{% endif %}</td>{% endfor %}</tr></tfoot>{% endif %}
</table></div>
{% if b.reconcile %}<p class="reconcile">{{ reconcile_line(b) }}</p>{% endif %}
{% endmacro %}

{# Flow: a directional pipeline. The connector sits at the FRONT of each node (never the last node
   of a line), so it wraps together with its node — no arrow ever dangles at a line break. #}
{% macro flow(b) %}
<div class="flow {{ b.style }}">
<div class="track">
{% if b.style == "steps" %}
{% for s in b.steps %}
<div class="step"><span class="link{% if loop.first %} blank{% endif %}"></span><div class="card{% if s.tone %} {{ s.tone }}{% endif %}">{% if b.numbered %}<span class="n">{{ loop.index }}</span>{% endif %}<div class="lab">{{ s.label }}</div>{% if s.note %}<div class="cap">{{ s.note | richtext }}</div>{% endif %}{% if s.badges %}{{ chip_keys(s.badges) }}{% endif %}</div></div>
{% endfor %}
{% else %}
{% for s in b.steps %}
<span class="seg">{% if not loop.first %}<span class="conn"></span>{% endif %}<span class="node{% if s.tone %} {{ s.tone }}{% endif %}">{% if b.numbered %}<span class="n">{{ loop.index }}</span>{% endif %}<span class="txt"><span class="lab">{{ s.label }}</span>{% if s.note %}<span class="sub">{{ s.note | richtext }}</span>{% endif %}{% if s.badges %}{{ chip_keys(s.badges) }}{% endif %}</span></span></span>
{% endfor %}
{% endif %}
</div>
{% if b.loop %}<div class="loop"><span class="cyc">↺</span> back to {{ b.steps[0].label }}</div>{% endif %}
</div>
{% endmacro %}

{# Fan: one-to-many convergence/divergence. The 'many' spokes sit in a dashed well; a single arrow
   joins them to the one hub. DOM order follows direction so the arrow always points along the flow. #}
{% macro fan_node(s) %}<div class="fnode{% if s.tone %} {{ s.tone }}{% endif %}"><span class="lab">{{ s.label }}</span>{% if s.note %}<span class="sub">{{ s.note | richtext }}</span>{% endif %}{% if s.badges %}{{ chip_keys(s.badges) }}{% endif %}</div>{% endmacro %}

{% macro fan_spokes(b) %}<div class="spokes">{% for s in b.spokes %}{{ fan_node(s) }}{% endfor %}</div>{% endmacro %}

{% macro fan(b) %}
<div class="fan {{ b.direction }}">
{% if b.direction == "out" %}<div class="hub">{{ fan_node(b.hub) }}</div><div class="merge"><span class="arw">→</span></div>{{ fan_spokes(b) }}
{% else %}{{ fan_spokes(b) }}<div class="merge"><span class="arw">→</span></div><div class="hub">{{ fan_node(b.hub) }}</div>{% endif %}
</div>
{% endmacro %}

{% macro chart(b) %}
<figure class="chart {{ b.variant }}">
{% if b.title %}<figcaption class="cap">{{ b.title }}</figcaption>{% endif %}
{{ chart_svg(b) }}
<div class="chart-legend">{% for item in chart_legend(b) %}<span><i style="background:{{ item.colour }}"></i>{{ item.label }}{% if item.note %} {{ item.note }}{% endif %}</span>{% endfor %}</div>
</figure>
{% endmacro %}

{% macro cmp_cell(cell) %}{% if cell is boolean %}{% if cell %}<span class="chk yes">✓</span>{% else %}<span class="chk no">✗</span>{% endif %}{% elif cell is string %}{{ cell | richtext }}{% else %}<span class="ct{% if cell.tone %} {{ cell.tone }}{% endif %}">{{ cell.value | richtext }}</span>{% endif %}{% endmacro %}

{% macro comparison(b) %}
<table class="cmp"><thead><tr><th></th>{% for opt in b.options %}<th{% if loop.index0 == b.highlight %} class="hl"{% endif %}>{{ opt }}</th>{% endfor %}</tr></thead>
<tbody>{% for row in b.rows %}<tr><td class="feat">{{ row.feature }}</td>{% for cell in row.values %}<td{% if loop.index0 == b.highlight %} class="hl"{% endif %}>{{ cmp_cell(cell) }}</td>{% endfor %}</tr>{% endfor %}</tbody></table>
{% endmacro %}

{% macro references(b) %}
<ol class="refs">{% for item in b.items %}<li id="ref-{{ item.key }}">{% if item.key in cited_references %}<a class="rnum" href="#fnref-{{ item.key }}">{{ reference_numbers[item.key] }}</a>{% else %}<span class="rnum">{{ reference_numbers[item.key] }}</span>{% endif %}<span class="rtext">{{ item.text | richtext }}{% if item.url %} <a class="rlink" href="{{ item.url }}">↗</a>{% endif %}</span></li>{% endfor %}</ol>
{% endmacro %}

{% macro render_block(block) %}
{% if block.type == "heading" %}
<h{{ block.level }} id="{{ heading_id(block) }}">{{ block.text }}</h{{ block.level }}>
{% elif block.type == "text" %}
{% for para in block.body.split("\n\n") %}<p class="text{% if block.muted %} muted{% endif %}">{{ para | richtext }}</p>{% endfor %}
{% elif block.type == "list" %}
<{{ "ol" if block.style == "number" else "ul" }} class="list">{% for item in block.items %}<li>{{ item | richtext }}</li>{% endfor %}</{{ "ol" if block.style == "number" else "ul" }}>
{% elif block.type == "fact_strip" %}
<div class="facts">{% for f in block.facts %}<span class="fact"><span class="k">{{ f.label }}</span><span>{{ f.value }}</span></span>{% endfor %}</div>
{% elif block.type == "key_value" %}
<dl class="kv">{% for p in block.pairs %}<dt>{{ p.label }}</dt><dd>{{ p.value | richtext }}</dd>{% endfor %}</dl>
{% elif block.type == "cards" %}
<div class="cards">{% for c in block.items %}<div class="card{% if c.tone %} {{ c.tone }}{% endif %}"><div class="l">{{ c.label }}</div><div class="n{% if c.value is string %} str{% elif c.value < 0 %} neg{% endif %}">{{ c.value | fmt }}{% if c.of %}<span class="pct">{{ pct(c.value, c.of) }}</span>{% endif %}{% if c.delta %}<span class="delta {{ c.delta.tone or 'neutral' }}">{% if c.delta.direction %}{{ DELTA_GLYPHS[c.delta.direction] }} {% endif %}{{ c.delta.label }}</span>{% endif %}</div>{% if c.note %}<div class="note">{{ c.note }}</div>{% endif %}{% if c.badges %}{{ chip_keys(c.badges) }}{% endif %}</div>{% endfor %}</div>
{% elif block.type == "badge_row" %}
<div class="badge-row">{% if block.label %}<span class="label">{{ block.label }}</span>{% endif %}{% for item in block.items %}{{ chip_item(item) }}{% endfor %}</div>
{% elif block.type == "callout" %}
<div class="callout {{ block.tone }}">{% if block.title %}<div class="title">{{ block.title }}</div>{% endif %}<div>{{ block.body | richtext }}</div></div>
{% elif block.type == "status_list" %}
<ul class="status-list">{% for item in block.items %}<li class="{{ item.state }}"><span class="glyph">{{ STATUS_GLYPHS[item.state] }}</span><span>{{ item.text | richtext }}</span></li>{% endfor %}</ul>
{% elif block.type == "meter" %}
<div class="meter">{% for m in block.items %}<span class="m-label">{{ m.label }}</span><div class="track"><div class="fill {{ m.tone or 'neutral' }}" style="width:{{ (m.value / m.max * 100) | round(1) }}%"></div></div><span class="m-val">{{ pct(m.value, m.max) }}</span>{% endfor %}</div>
{% elif block.type == "code" %}
<div class="code">{% if block.label %}<div class="code-label">{{ block.label }}</div>{% endif %}{% if block.mode == "diff" %}<pre class="diff">{% for line in block.content.split("\n") %}<span class="ln {{ 'add' if line.startswith('+') else 'del' if line.startswith('-') else 'ctx' }}">{{ line[1:] if (line.startswith('+') or line.startswith('-')) else line }}</span>{% endfor %}</pre>{% else %}<pre>{{ block.content }}</pre>{% endif %}</div>
{% elif block.type == "quote" %}
<blockquote class="quote"><div>{{ block.body | richtext }}</div>{% if block.cite %}<span class="cite">{{ block.cite }}</span>{% endif %}</blockquote>
{% elif block.type == "image" %}
<figure class="fig"{% if block.max_width %} style="max-width:{{ block.max_width }}px"{% endif %}><div class="frame"><img src="{{ block.src }}" alt="{{ block.alt }}"></div>{% if block.caption %}<figcaption>{{ block.caption }}</figcaption>{% endif %}</figure>
{% elif block.type == "timeline" %}
<ul class="tl">{% for it in block.items %}<li{% if it.state %} class="{{ it.state }}"{% endif %}>{% if it.time %}<div class="time">{{ it.time }}</div>{% endif %}<div class="ti">{{ it.title }}</div>{% if it.body %}<div class="tb">{{ it.body | richtext }}</div>{% endif %}{% if it.badges %}{{ chip_keys(it.badges) }}{% endif %}</li>{% endfor %}</ul>
{% elif block.type == "flow" %}
{{ flow(block) }}
{% elif block.type == "fan" %}
{{ fan(block) }}
{% elif block.type == "chart" %}
{{ chart(block) }}
{% elif block.type == "comparison" %}
{{ comparison(block) }}
{% elif block.type == "references" %}
{{ references(block) }}
{% elif block.type == "table" %}
{{ table(block) }}
{% elif block.type == "section" %}
<details class="section"{% if not block.collapsed or expand_details %} open{% endif %}><summary>{{ block.title }}</summary><div class="section-body">{% for inner in block.blocks %}{{ render_block(inner) }}{% endfor %}</div></details>
{% elif block.type == "grid" %}
<div class="grid">{% for cell in block.cells %}<div class="cell span-{{ cell.span }}{% if cell.tone %} panel {{ cell.tone }}{% endif %}">{% for inner in cell.blocks %}{{ render_block(inner) }}{% endfor %}</div>{% endfor %}</div>
{% elif block.type == "walkthrough" %}
<div class="walk" style="grid-template-columns:minmax(120px,{{ block.step_span }}fr) {{ 6 - block.step_span }}fr">{% for step in block.steps %}<div class="wstep{% if step.tone %} {{ step.tone }}{% endif %}"><span class="wnum">{{ loop.index }}</span><span class="wlabel">{{ step.label }}{% if step.sub %}<span class="wsub">{{ step.sub | richtext }}</span>{% endif %}</span></div><div class="wdetail">{% for inner in step.detail %}{{ render_block(inner) }}{% endfor %}</div>{% endfor %}</div>
{% endif %}
{% endmacro %}
