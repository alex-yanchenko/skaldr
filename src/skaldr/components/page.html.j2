{% import "macros.html.j2" as m %}<!doctype html>
<!-- Generated by skaldr — a component framework for AI-authored report pages.
     Install & docs: https://github.com/alex-yanchenko/skaldr -->
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<!-- Hardening: default-src 'none' blocks every external load and scripted network request
     (fetch/XHR/beacon/img/websocket); the two script hashes admit only skaldr's own inline scripts,
     so an injected inline script won't run. (Top-level navigation isn't constrainable by CSP.) The
     script-hash test in tests/test_render.py recomputes these from the rendered output — if a
     script changes, that test fails until the hash below is updated. -->
<meta http-equiv="Content-Security-Policy" content="default-src 'none'; img-src data:; style-src 'unsafe-inline'; script-src 'sha256-Pp/Bwhev7+nUbmX6BHi0JedrZZ1dY/dDnDpmYCYsAPo=' 'sha256-CZmXAqjKGs0k+zATdC/z+dqrhtWKhrZcRGJZoU+3Ki8='; base-uri 'none'; form-action 'none'">
<title>{{ meta.title }}</title>
<style>{{ styles | safe }}</style>
<script>
/* Apply the saved theme before first paint so a remembered choice causes no flash. Width is not
   persisted — it is a per-document control that resets to the author's meta.width on reload. */
(function () {
	try {
		var theme = localStorage.getItem("skaldr-theme");
		if (theme === "light" || theme === "dark") document.documentElement.setAttribute("data-theme", theme);
	} catch (err) {}
})();
</script>
</head>
<body>
<div class="wrap width-{{ meta.width }}">
<h1>{{ meta.title }}</h1>
{% for line in meta.subtitle %}<p class="subtitle">{{ line }}</p>{% endfor %}
{% if toc %}<nav class="toc">{% for slug, text in toc %}<a href="#{{ slug }}">{{ text }}</a>{% endfor %}</nav>{% endif %}
{% if used_badges and first_table_index is none %}{{ m.legend(used_badges) }}{% endif %}
{% for block in blocks %}
{% if used_badges and loop.index0 == first_table_index %}{{ m.legend(used_badges) }}{% endif %}
{{ m.render_block(block) }}
{% endfor %}
{% if footer %}<div class="footer">{{ footer }}</div>{% endif %}
<div class="credit">Generated with <a href="https://github.com/alex-yanchenko/skaldr">skaldr</a></div>
</div>
<div class="sc" data-open="false">
<button class="sc-btn" type="button" aria-label="Display settings" aria-expanded="false" aria-controls="sc-menu">
<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><line x1="4" y1="8" x2="20" y2="8"/><line x1="4" y1="16" x2="20" y2="16"/><circle cx="9" cy="8" r="2.6" fill="var(--surface)"/><circle cx="15" cy="16" r="2.6" fill="var(--surface)"/></svg>
</button>
<div class="sc-menu" id="sc-menu" role="group" aria-label="Display settings" hidden>
<div class="sc-row"><span class="sc-lbl">Theme</span><div class="sc-seg" role="group" aria-label="Theme"><button type="button" aria-pressed="false" data-set="theme" data-val="auto">Auto</button><button type="button" aria-pressed="false" data-set="theme" data-val="light">Light</button><button type="button" aria-pressed="false" data-set="theme" data-val="dark">Dark</button></div></div>
<div class="sc-row"><span class="sc-lbl">Width</span><div class="sc-seg" role="group" aria-label="Width"><button type="button" aria-pressed="false" data-set="width" data-val="default">Default</button><button type="button" aria-pressed="false" data-set="width" data-val="wide">Wide</button><button type="button" aria-pressed="false" data-set="width" data-val="full">Full</button></div></div>
</div>
</div>
<script>
(function () {
	var root = document.documentElement;
	var controls = document.querySelector(".sc");
	if (!controls) return;
	var button = controls.querySelector(".sc-btn");
	var menu = controls.querySelector(".sc-menu");
	if (!button || !menu) return;
	var wrap = document.querySelector(".wrap");
	/* Author's width is the .wrap width-<mode> class; no other class on .wrap matches width-\w+. */
	var authorWidth = (wrap && (wrap.className.match(/width-(\w+)/) || [])[1]) || "default";

	function save(key, value) { try { localStorage.setItem(key, value); } catch (err) {} }
	function drop(key) { try { localStorage.removeItem(key); } catch (err) {} }

	function setOpen(isOpen) {
		controls.dataset.open = isOpen ? "true" : "false";
		button.setAttribute("aria-expanded", isOpen ? "true" : "false");
		menu.hidden = !isOpen;
	}

	function syncGroup(kind, active) {
		controls.querySelectorAll('[data-set="' + kind + '"]').forEach(function (item) {
			var on = item.dataset.val === active;
			item.setAttribute("aria-pressed", on ? "true" : "false");
			item.classList.toggle("on", on);
		});
	}
	function reflect() {
		syncGroup("theme", root.getAttribute("data-theme") || "auto");
		syncGroup("width", root.getAttribute("data-width") || authorWidth);
	}

	button.addEventListener("click", function (event) { event.stopPropagation(); setOpen(controls.dataset.open !== "true"); });
	document.addEventListener("click", function (event) { if (!controls.contains(event.target)) setOpen(false); });
	document.addEventListener("keydown", function (event) { if (event.key === "Escape") setOpen(false); });

	controls.querySelectorAll("[data-set]").forEach(function (item) {
		item.addEventListener("click", function () {
			if (item.dataset.set === "theme") {
				if (item.dataset.val === "auto") { root.removeAttribute("data-theme"); drop("skaldr-theme"); }
				else { root.setAttribute("data-theme", item.dataset.val); save("skaldr-theme", item.dataset.val); }
			} else {
				/* Width is a transient per-view override — not persisted, so a new page keeps the author's width. */
				root.setAttribute("data-width", item.dataset.val);
			}
			reflect();
		});
	});
	reflect();
})();
</script>
</body>
</html>
