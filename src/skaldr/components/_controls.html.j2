<div class="sc" data-open="false">
{% if toc %}<button class="toc-btn" type="button" aria-label="Contents" aria-expanded="false" aria-controls="{{ contents_panel_id }}" popovertarget="{{ contents_panel_id }}">
<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><line x1="9" y1="6" x2="20" y2="6"/><line x1="9" y1="12" x2="20" y2="12"/><line x1="9" y1="18" x2="20" y2="18"/><circle cx="4.5" cy="6" r="1"/><circle cx="4.5" cy="12" r="1"/><circle cx="4.5" cy="18" r="1"/></svg>
</button>
{% endif %}<button class="sc-btn" type="button" aria-label="Display settings" aria-expanded="false" aria-controls="{{ settings_menu_id }}">
<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><line x1="4" y1="8" x2="20" y2="8"/><line x1="4" y1="16" x2="20" y2="16"/><circle cx="9" cy="8" r="2.6" fill="var(--surface)"/><circle cx="15" cy="16" r="2.6" fill="var(--surface)"/></svg>
</button>
<div class="sc-menu" id="{{ settings_menu_id }}" role="group" aria-label="Display settings" hidden>
<div class="sc-row"><span class="sc-lbl">Theme</span><div class="sc-seg" role="group" aria-label="Theme"><button type="button" aria-pressed="false" data-set="theme" data-val="auto">Auto</button><button type="button" aria-pressed="false" data-set="theme" data-val="light">Light</button><button type="button" aria-pressed="false" data-set="theme" data-val="dark">Dark</button></div></div>
<div class="sc-row"><span class="sc-lbl">Width</span><div class="sc-seg" role="group" aria-label="Width"><button type="button" aria-pressed="false" data-set="width" data-val="default">Default</button><button type="button" aria-pressed="false" data-set="width" data-val="wide">Wide</button><button type="button" aria-pressed="false" data-set="width" data-val="full">Full</button></div></div>
</div>
{% if toc %}<nav class="toc-pop" id="{{ contents_panel_id }}" popover="manual" aria-label="Table of contents">
<div class="toc-pop-hd">On this page</div>
{% for slug, text in toc %}<a href="#{{ slug }}">{{ text }}</a>{% endfor %}
</nav>
{% endif %}</div>
<script>
(function () {
	var root = document.documentElement;
	var controls = document.querySelector(".sc");
	if (!controls) return;
	var button = controls.querySelector(".sc-btn");
	var menu = controls.querySelector(".sc-menu");
	if (!button || !menu) return;
	var defaultWidth = "default";
	var contentsButton = controls.querySelector(".toc-btn");
	var contentsPanel = controls.querySelector(".toc-pop");

	function contentsOpen() {
		try { return contentsPanel.matches(":popover-open"); } catch (err) { return false; }
	}
	function closeContents() { if (contentsOpen()) contentsPanel.hidePopover(); }

	function save(key, value) { try { localStorage.setItem(key, value); } catch (err) {} }
	function drop(key) { try { localStorage.removeItem(key); } catch (err) {} }

	function setOpen(isOpen) {
		controls.dataset.open = isOpen ? "true" : "false";
		button.setAttribute("aria-expanded", isOpen ? "true" : "false");
		menu.hidden = !isOpen;
		if (isOpen) closeContents();
	}

	if (contentsPanel && contentsButton) {
		contentsPanel.addEventListener("toggle", function (event) {
			var isOpen = event.newState === "open";
			contentsButton.setAttribute("aria-expanded", isOpen ? "true" : "false");
			if (isOpen) setOpen(false);
		});
		contentsPanel.addEventListener("click", function (event) {
			var onNarrowScreen = window.matchMedia("(max-width: 900px)").matches;
			if (onNarrowScreen && event.target.closest("a")) closeContents();
		});
	}

	function syncGroup(kind, active) {
		controls.querySelectorAll('[data-set="' + kind + '"]').forEach(function (item) {
			var on = item.dataset.val === active;
			item.setAttribute("aria-pressed", on ? "true" : "false");
			item.classList.toggle("on", on);
		});
	}
	function reflect() {
		syncGroup("theme", root.getAttribute("data-theme") || "auto");
		syncGroup("width", root.getAttribute("data-width") || defaultWidth);
	}

	button.addEventListener("click", function (event) { event.stopPropagation(); setOpen(controls.dataset.open !== "true"); });
	document.addEventListener("click", function (event) { if (!controls.contains(event.target)) setOpen(false); });
	document.addEventListener("keydown", function (event) {
		if (event.key !== "Escape") return;
		setOpen(false);
		closeContents();
	});

	controls.querySelectorAll("[data-set]").forEach(function (item) {
		item.addEventListener("click", function () {
			if (item.dataset.set === "theme") {
				if (item.dataset.val === "auto") { root.removeAttribute("data-theme"); drop("skaldr-theme"); }
				else { root.setAttribute("data-theme", item.dataset.val); save("skaldr-theme", item.dataset.val); }
			} else {
				if (item.dataset.val === defaultWidth) { root.removeAttribute("data-width"); drop("skaldr-width"); }
				else { root.setAttribute("data-width", item.dataset.val); save("skaldr-width", item.dataset.val); }
			}
			reflect();
		});
	});
	reflect();

	/* Collapsed sections hide their content when printed. Expand every <details> for print, then
	   restore each to how the reader left it — so a PDF captures the whole report. */
	window.addEventListener("beforeprint", function () {
		document.querySelectorAll("details").forEach(function (item) {
			item.dataset.printOpen = item.open ? "1" : "0";
			item.open = true;
		});
	});
	window.addEventListener("afterprint", function () {
		document.querySelectorAll("details").forEach(function (item) { item.open = item.dataset.printOpen === "1"; });
	});
})();
</script>
