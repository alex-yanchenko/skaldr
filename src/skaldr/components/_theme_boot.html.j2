<script>
(function () {
	function restore(key, attribute, known) {
		var value = localStorage.getItem(key);
		if (known.indexOf(value) !== -1) document.documentElement.setAttribute(attribute, value);
		else if (value !== null) localStorage.removeItem(key);
	}
	try {
		restore("skaldr-theme", "data-theme", ["light", "dark"]);
		restore("skaldr-width", "data-width", ["wide", "full"]);
	} catch (err) {}
})();
</script>
