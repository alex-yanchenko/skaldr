<script>
(function () {
	try {
		var theme = localStorage.getItem("skaldr-theme");
		if (theme === "light" || theme === "dark") document.documentElement.setAttribute("data-theme", theme);
		var width = localStorage.getItem("skaldr-width");
		if (width === "wide" || width === "full") document.documentElement.setAttribute("data-width", width);
	} catch (err) {}
})();
</script>
